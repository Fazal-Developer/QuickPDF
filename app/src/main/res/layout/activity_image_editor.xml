<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Custom Toolbar Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1F1F1F"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="Edit Image"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="sans-serif-bold"/>

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:text="Save"
            android:textColor="#FB8C00"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

    </RelativeLayout>

    <!-- Editor Workspace / Viewport -->
    <FrameLayout
        android:id="@+id/editor_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:padding="16dp">

        <!-- Image Preview -->
        <ImageView
            android:id="@+id/iv_editor_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"/>

        <!-- Touch Crop overlay (drawn exactly over the image) -->
        <com.hhhdeveloper.swiftpdf.ui.imagetopdf.CropOverlayView
            android:id="@+id/crop_overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Action panel at bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1F1F1F"
        android:padding="16dp">

        <!-- Filter Choice Chips -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scanner Filter"
            android:textColor="#B0B0B0"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_original"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Original"
                    android:checkable="true"
                    android:checked="true"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#333333"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_grayscale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grayscale"
                    android:checkable="true"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#333333"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_doc_scan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doc Scan (B&amp;W)"
                    android:checkable="true"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#333333"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_enhance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enhance"
                    android:checkable="true"
                    android:textColor="@color/white"
                    app:chipBackgroundColor="#333333"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Edit Operations Row (Rotate, Crop Toggle) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Rotate Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rotate_cw"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Rotate 90°"
                android:textSize="13sp"
                app:icon="@android:drawable/ic_menu_rotate"
                android:backgroundTint="#2C2C2C"
                android:textColor="@color/white"
                style="@style/Widget.MaterialComponents.Button"/>

            <!-- Crop Toggle Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_crop_toggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Crop margins"
                android:textSize="13sp"
                app:icon="@android:drawable/ic_menu_crop"
                android:backgroundTint="#2C2C2C"
                android:textColor="@color/white"
                style="@style/Widget.MaterialComponents.Button"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
