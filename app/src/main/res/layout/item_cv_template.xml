<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Mini A4 Preview Canvas Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#F8F9FD"
            android:padding="12dp">

            <com.hhhdeveloper.swiftpdf.ui.cv.views.CvPreviewView
                android:id="@+id/mini_preview_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <!-- Badges Row Top Right -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_photo_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷 Photo"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-bold"
                    android:background="@drawable/bg_pill_primary"
                    android:backgroundTint="#00B0FF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tv_ats_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ ATS"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-bold"
                    android:background="@drawable/bg_pill_primary"
                    android:backgroundTint="#388E3C"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp" />

            </LinearLayout>
        </FrameLayout>

        <!-- Template Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_template_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Classic Professional"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/tv_template_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Single column clean layout. Recruiter approved."
                android:textColor="@color/textSecondary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_use_template"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="Use Template"
                style="@style/Widget.QuickPDF.Button.Primary" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
