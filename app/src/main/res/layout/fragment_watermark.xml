<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Clean Text Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pdf_watermark"
                android:textColor="@color/textPrimary"
                android:textSize="24sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Apply a custom text watermark overlay to pages"
                android:textColor="@color/textSecondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Select PDF Card Zone -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_select_pdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/watermarkTint">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_watermark"
                        app:tint="@color/colorPrimary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_select_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose PDF Document"
                        android:textColor="@color/textPrimary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_select_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tap to browse files"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/textSecondary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Watermark Options Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Text field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watermark Text"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_watermark_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. CONFIDENTIAL"
                        android:text="CONFIDENTIAL"
                        android:singleLine="true"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Text Size Slider -->
                <TextView
                    android:id="@+id/tv_text_size_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Text Size: 40sp"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_text_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="12"
                    android:valueTo="96"
                    android:value="40"
                    app:thumbColor="@color/colorPrimary"
                    app:trackColorActive="@color/colorPrimary"
                    app:labelBehavior="floating" />

                <!-- Rotation Slider -->
                <TextView
                    android:id="@+id/tv_rotation_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Rotation Angle: 45°"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_rotation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="360"
                    android:value="45"
                    app:thumbColor="@color/colorPrimary"
                    app:trackColorActive="@color/colorPrimary"
                    app:labelBehavior="floating" />

                <!-- Color selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Watermark Color"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_grey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Light Grey"
                        android:checkable="true"
                        android:checked="true"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_red"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dusty Red"
                        android:checkable="true"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_blue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Navy Blue"
                        android:checkable="true"
                        style="@style/Widget.MaterialComponents.Chip.Choice" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Process Button — solid purple 28dp pill button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_watermark"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            android:text="Apply Watermark"
            android:textSize="16sp"
            android:textAllCaps="false"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="28dp"
            style="@style/Widget.QuickPDF.Button.Primary" />

    </LinearLayout>
</ScrollView>
