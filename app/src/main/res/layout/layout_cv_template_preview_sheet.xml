<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="20dp">

    <!-- Bottom Sheet Drag Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_pill_primary"
        android:backgroundTint="#CBD5E0"
        android:layout_marginBottom="16dp" />

    <!-- Template Header & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_preview_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Classic Professional"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:id="@+id/tv_badge_ats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ ATS Friendly"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_pill_primary"
            android:backgroundTint="#388E3C"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tv_badge_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 Profile Photo"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_pill_primary"
            android:backgroundTint="#00B0FF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_preview_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Single column clean layout. Recruiter approved."
        android:textColor="@color/textSecondary"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <!-- A4 Canvas Preview Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/dividerColor"
        app:cardBackgroundColor="#F8F9FD">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <com.hhhdeveloper.swiftpdf.ui.cv.views.CvPreviewView
                android:id="@+id/full_preview_canvas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Use Template Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_use_this_template"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Use This Template ✨"
        style="@style/Widget.QuickPDF.Button.Primary" />

</LinearLayout>
